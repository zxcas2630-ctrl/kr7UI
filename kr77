    -- ===== WINDOW OBJECT =====
    local Window = {}
    Window.__index = Window

    function Window.new()
        local self = setmetatable({}, Window)
        self.Tabs = {}
        self.TabNames = {}
        self.CurrentTab = nil
        self.SearchBox = SearchBox
        self.Scroll = Scroll
        self.ContentTitle = ContentTitle

        SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
            self:Search(SearchBox.Text:lower())
        end)

        return self
    end

    function Window:CreateTab(name)
        if self.Tabs[name] then return self.Tabs[name] end

        local button = New("TextButton", {
            Size = UDim2.new(1, 0, 0, 38),
            BackgroundTransparency = 1,
            BackgroundColor3 = C.Selected,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false
        }, TabsContainer)
        Round(button, 7)

        local indicator = New("Frame", {
            Size = UDim2.fromOffset(3, 20),
            Position = UDim2.new(0, 0, .5, -10),
            BackgroundColor3 = C.Accent,
            BorderSizePixel = 0,
            Visible = false
        }, button)
        Round(indicator, 5)

        local label = New("TextLabel", {
            Size = UDim2.new(1, -25, 1, 0),
            Position = UDim2.fromOffset(17, 0),
            BackgroundTransparency = 1,
            Text = name,
            Font = Enum.Font.GothamMedium,
            TextSize = 13,
            TextColor3 = C.Sub,
            TextXAlignment = Enum.TextXAlignment.Left
        }, button)

        local tab = {
            Name = name,
            Button = button,
            Indicator = indicator,
            Label = label,
            Elements = {}
        }

        self.Tabs[name] = tab
        table.insert(self.TabNames, name)

        button.MouseButton1Click:Connect(function()
            self:SelectTab(name)
        end)

        button.MouseEnter:Connect(function()
            if self.CurrentTab ~= name then
                Tween(button, { BackgroundTransparency = .5, BackgroundColor3 = C.Hover })
                Tween(label, { TextColor3 = C.Text })
            end
        end)
        button.MouseLeave:Connect(function()
            if self.CurrentTab ~= name then
                Tween(button, { BackgroundTransparency = 1 })
                Tween(label, { TextColor3 = C.Sub })
            end
        end)

        if not self.CurrentTab then
            self:SelectTab(name)
        end

        return tab
    end

    function Window:SelectTab(name)
        local tab = self.Tabs[name]
        if not tab then return end

        self.CurrentTab = name
        SearchBox.Text = ""

        for t, data in pairs(self.Tabs) do
            local selected = (t == name)
            data.Indicator.Visible = selected
            Tween(data.Label, { TextColor3 = selected and C.Text or C.Sub })
            Tween(data.Button, {
                BackgroundTransparency = selected and 0 or 1,
                BackgroundColor3 = selected and C.Selected or C.Top
            })
        end

        self:RenderTab(name)
    end

    function Window:RenderTab(name)
        local tab = self.Tabs[name]
        if not tab then return end

        for _, child in ipairs(Scroll:GetChildren()) do
            if child:IsA("GuiObject") and not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
                child:Destroy()
            end
        end

        self.ContentTitle.Text = name

        for _, feature in ipairs(tab.Elements) do
            if feature.type == "button" then BuildButton(feature)
            elseif feature.type == "toggle" then BuildToggle(feature)
            elseif feature.type == "slider" then BuildSlider(feature)
            elseif feature.type == "dropdown" then BuildDropdown(feature)
            elseif feature.type == "textbox" then BuildTextbox(feature)
            end
        end
    end

    function Window:Search(query)
        for _, child in ipairs(Scroll:GetChildren()) do
            if child:IsA("GuiObject") and not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
                child:Destroy()
            end
        end

        if query == "" then
            if self.CurrentTab then
                self:RenderTab(self.CurrentTab)
            end
            return
        end

        self.ContentTitle.Text = "Search"

        local found = false
        for tabName, tab in pairs(self.Tabs) do
            for _, feature in ipairs(tab.Elements) do
                if feature.label:lower():find(query, 1, true) then
                    found = true
                    New("TextLabel", {
                        Size = UDim2.new(1, -5, 0, 16),
                        BackgroundTransparency = 1,
                        Text = tabName,
                        Font = Enum.Font.GothamMedium,
                        TextSize = 10,
                        TextColor3 = C.Sub,
                        TextXAlignment = Enum.TextXAlignment.Left
                    }, Scroll)
                    if feature.type == "button" then BuildButton(feature)
                    elseif feature.type == "toggle" then BuildToggle(feature)
                    elseif feature.type == "slider" then BuildSlider(feature)
                    elseif feature.type == "dropdown" then BuildDropdown(feature)
                    elseif feature.type == "textbox" then BuildTextbox(feature)
                    end
                end
            end
        end

        if not found then
            New("TextLabel", {
                Size = UDim2.new(1, -5, 0, 40),
                BackgroundTransparency = 1,
                Text = "No features found",
                Font = Enum.Font.Gotham,
                TextSize = 13,
                TextColor3 = C.Sub
            }, Scroll)
        end
    end

    -- ===== TAB METHODS =====
    local Tab = {}
    Tab.__index = Tab

    function Tab:AddButton(label, desc, callback)
        table.insert(self.Elements, { type = "button", label = label, desc = desc, callback = callback })
        if self._Window and self._Window.CurrentTab == self.Name then
            self._Window:RenderTab(self.Name)
        end
    end

    function Tab:AddToggle(label, desc, callback)
        table.insert(self.Elements, { type = "toggle", label = label, desc = desc, callback = callback })
        if self._Window and self._Window.CurrentTab == self.Name then
            self._Window:RenderTab(self.Name)
        end
    end

    function Tab:AddSlider(label, desc, min, max, default, callback)
        table.insert(self.Elements, { type = "slider", label = label, desc = desc, min = min, max = max, default = default, callback = callback })
        if self._Window and self._Window.CurrentTab == self.Name then
            self._Window:RenderTab(self.Name)
        end
    end

    function Tab:AddDropdown(label, desc, options, callback)
        table.insert(self.Elements, { type = "dropdown", label = label, desc = desc, options = options, callback = callback })
        if self._Window and self._Window.CurrentTab == self.Name then
            self._Window:RenderTab(self.Name)
        end
    end

    function Tab:AddTextbox(label, desc, placeholder, callback)
        table.insert(self.Elements, { type = "textbox", label = label, desc = desc, placeholder = placeholder, callback = callback })
        if self._Window and self._Window.CurrentTab == self.Name then
            self._Window:RenderTab(self.Name)
        end
    end

    -- Patch CreateTab to set _Window reference
    local originalCreateTab = Window.CreateTab
    function Window:CreateTab(name)
        local tab = originalCreateTab(self, name)
        tab._Window = self
        setmetatable(tab, Tab)
        return tab
    end

    for _, tab in pairs(self.Tabs) do
        setmetatable(tab, Tab)
        tab._Window = self
    end

    -- ===== RETURN =====
    return Window.new()
end
