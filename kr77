        drop.MouseLeave:Connect(function() if not open then Tween(drop, {BackgroundColor3 = C.Panel2}) end end)
        drop.MouseButton1Click:Connect(function()
            open = not open
            Tween(drop, { BackgroundColor3 = open and C.Hover or C.Panel2 })
            Tween(list, {
                Size = open and UDim2.new(1, 0, 0, #options * optionHeight + 10) or UDim2.new(1, 0, 0, 0)
