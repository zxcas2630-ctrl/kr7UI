    }, Gui)
    Round(Main, 11)
    Stroke(Main)

    local Clip = New("Frame", {
        Size = UDim2.new(1, -2, 1, -2),
        Position = UDim2.fromOffset(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ClipsDescendants = true
    }, Main)
    Round(Clip, 10)

