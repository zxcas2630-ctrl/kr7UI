    }, Scroll)
    New("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, Scroll)

    -- ===== DRAG / RESIZE =====
    local Drag = New("TextButton", {
        Size = UDim2.fromOffset(40, 40),
        Position = UDim2.new(1, -44, 0, 8),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 20
    }, Main)
    for x = 0, 1 do
        for y = 0, 2 do
            local dot = New("Frame", {
                Size = UDim2.fromOffset(3, 3),
                Position = UDim2.fromOffset(13 + x*7, 10 + y*7),
                BackgroundColor3 = C.Sub,
                BorderSizePixel = 0,
                ZIndex = 21
            }, Drag)
            Round(dot, 10)
            Drag.MouseEnter:Connect(function() Tween(dot, {BackgroundColor3 = C.Accent}) end)
            Drag.MouseLeave:Connect(function() Tween(dot, {BackgroundColor3 = C.Sub}) end)
        end
    end

    local Resize = New("TextButton", {
        Size = UDim2.fromOffset(36, 36),
        Position = UDim2.new(1, -36, 1, -36),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 20
    }, Main)
    for i = 0, 2 do
        local line = New("Frame", {
            Size = UDim2.fromOffset(2, 9 + i*5),
            Position = UDim2.new(1, -7 - i*6, 1, -8),
            AnchorPoint = Vector2.new(.5, 1),
            Rotation = 45,
            BackgroundColor3 = C.Sub,
            BorderSizePixel = 0,
            ZIndex = 21
        }, Resize)
        Round(line, 5)
        Resize.MouseEnter:Connect(function() Tween(line, {BackgroundColor3 = C.Accent}) end)
        Resize.MouseLeave:Connect(function() Tween(line, {BackgroundColor3 = C.Sub}) end)
    end

    local dragData = { dragging = false, start = nil, pos = nil }
    Drag.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragData.dragging = true
            dragData.start = input.Position
            dragData.pos = Main.Position
        end
    end)

    local resizeData = { resizing = false, start = nil, size = nil }
    Resize.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            resizeData.resizing = true
            resizeData.start = input.Position
            resizeData.size = Main.AbsoluteSize
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        if dragData.dragging then
            local delta = input.Position - dragData.start
            Main.Position = UDim2.new(
                dragData.pos.X.Scale, dragData.pos.X.Offset + delta.X,
                dragData.pos.Y.Scale, dragData.pos.Y.Offset + delta.Y
            )
        end
        if resizeData.resizing then
            local delta = input.Position - resizeData.start
            local w = math.clamp(resizeData.size.X + delta.X, MIN_SIZE.X, MAX_SIZE.X)
            local h = math.clamp(resizeData.size.Y + delta.Y, MIN_SIZE.Y, MAX_SIZE.Y)
            Main.Size = UDim2.fromOffset(w, h)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragData.dragging = false
            resizeData.resizing = false
        end
    end)

    -- Right Shift toggle
    local visible = true
    UIS.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.RightShift then
            visible = not visible
            if visible then
                Main.Visible = true
                Main.BackgroundTransparency = 1
                Tween(Main, {BackgroundTransparency = 0}, .2)
            else
                Main.Visible = false
            end
        end
    end)

    -- ===== FEATURE BUILDERS =====
    local function Base(height)
        local frame = New("Frame", {
            Size = UDim2.new(1, -5, 0, height),
            BackgroundColor3 = C.Panel,
            BorderSizePixel = 0
        }, Scroll)
        Round(frame, 8)
        Stroke(frame)
        return frame
    end

    local function BuildButton(feature)
        local holder = Base(54)
        local btn = New("TextButton", {
            Size = UDim2.new(1, -20, 1, -10),
            Position = UDim2.fromOffset(10, 5),
            BackgroundColor3 = C.Panel2,
            BorderSizePixel = 0,
            Text = feature.label,
            Font = Enum.Font.GothamMedium,
            TextSize = 13,
            TextColor3 = C.Text,
            AutoButtonColor = false
        }, holder)
        Round(btn, 7)
        btn.MouseEnter:Connect(function() Tween(btn, {BackgroundColor3 = C.Hover}) end)
        btn.MouseLeave:Connect(function() Tween(btn, {BackgroundColor3 = C.Panel2}) end)
        btn.MouseButton1Click:Connect(function()
            if feature.callback then feature.callback() end
        end)
    end

    local function BuildToggle(feature)
        local holder = Base(58)
        New("TextLabel", {
            Size = UDim2.new(1, -80, 0, 22),
            Position = UDim2.fromOffset(12, 6),
            BackgroundTransparency = 1,
            Text = feature.label,
            Font = Enum.Font.GothamMedium,
            TextSize = 13,
            TextColor3 = C.Text,
            TextXAlignment = Enum.TextXAlignment.Left
        }, holder)
        New("TextLabel", {
            Size = UDim2.new(1, -80, 0, 18),
            Position = UDim2.fromOffset(12, 29),
            BackgroundTransparency = 1,
            Text = feature.desc,
            Font = Enum.Font.Gotham,
            TextSize = 10,
            TextColor3 = C.Sub,
            TextXAlignment = Enum.TextXAlignment.Left
        }, holder)

        local toggle = New("TextButton", {
            Size = UDim2.fromOffset(40, 21),
            Position = UDim2.new(1, -52, .5, -10),
            BackgroundColor3 = C.Panel2,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false
        }, holder)
        Round(toggle, 20)
        local dot = New("Frame", {
            Size = UDim2.fromOffset(15, 15),
            Position = UDim2.fromOffset(3, 3),
            BackgroundColor3 = C.Sub,
            BorderSizePixel = 0
        }, toggle)
        Round(dot, 20)

        local enabled = false
        toggle.MouseButton1Click:Connect(function()
            enabled = not enabled
            Tween(toggle, { BackgroundColor3 = enabled and C.AccentDark or C.Panel2 })
            Tween(dot, {
                Position = enabled and UDim2.new(1, -18, 0, 3) or UDim2.fromOffset(3, 3),
                BackgroundColor3 = enabled and C.Accent or C.Sub
            })
            if feature.callback then feature.callback(enabled) end
        end)
    end

    local function BuildSlider(feature)
        local holder = Base(72)
        New("TextLabel", {
            Size = UDim2.new(1, -70, 0, 22),
            Position = UDim2.fromOffset(12, 6),
            BackgroundTransparency = 1,
            Text = feature.label,
            Font = Enum.Font.GothamMedium,
            TextSize = 13,
            TextColor3 = C.Text,
            TextXAlignment = Enum.TextXAlignment.Left
        }, holder)

        local valueLabel = New("TextLabel", {
            Size = UDim2.fromOffset(50, 22),
            Position = UDim2.new(1, -62, 0, 6),
            BackgroundTransparency = 1,
            Text = tostring(feature.default or 0),
            Font = Enum.Font.GothamMedium,
            TextSize = 12,
            TextColor3 = C.Accent,
            TextXAlignment = Enum.TextXAlignment.Right
        }, holder)

        local bar = New("TextButton", {
            Size = UDim2.new(1, -24, 0, 5),
            Position = UDim2.fromOffset(12, 50),
            BackgroundColor3 = C.Panel2,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false
        }, holder)
        Round(bar, 10)

        local min = feature.min or 0
        local max = feature.max or 100
        local def = feature.default or (min + max)/2
        def = math.clamp(def, min, max)

        local fill = New("Frame", {
            Size = UDim2.new((def - min)/(max - min), 0, 1, 0),
            BackgroundColor3 = C.Accent,
            BorderSizePixel = 0
        }, bar)
        Round(fill, 10)

        local knob = New("Frame", {
            Size = UDim2.fromOffset(11, 11),
            AnchorPoint = Vector2.new(.5, .5),
            Position = UDim2.new(fill.Size.X.Scale, 0, .5, 0),
            BackgroundColor3 = C.Accent,
            BorderSizePixel = 0
        }, bar)
        Round(knob, 20)

        local dragging = false
        local function update(x)
            local percent = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            local v = math.floor(min + (max - min) * percent + 0.5)
            fill.Size = UDim2.new(percent, 0, 1, 0)
            knob.Position = UDim2.new(percent, 0, .5, 0)
            valueLabel.Text = tostring(v)
            if feature.callback then feature.callback(v) end
        end

        bar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                update(input.Position.X)
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                update(input.Position.X)
            end
        end)
        UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
        end)
    end

