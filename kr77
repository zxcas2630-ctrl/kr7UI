-- Kr7 UI Library
-- Load with: local Kr7 = loadstring(game:HttpGet("RAW_URL"))()

return function(config)
    config = config or {}
    local VERSION = "v1.0.1"

    local MIN_SIZE = config.MinSize or Vector2.new(600, 380)
    local MAX_SIZE = config.MaxSize or Vector2.new(1000, 700)
    local DEFAULT_SIZE = config.DefaultSize or Vector2.new(720, 470)
    local TITLE = config.Title or "Kr7"

    local C = {
        Background = Color3.fromRGB(22, 21, 39),
        Top = Color3.fromRGB(27, 26, 46),
        Panel = Color3.fromRGB(30, 29, 50),
        Panel2 = Color3.fromRGB(36, 34, 58),
        Hover = Color3.fromRGB(44, 42, 70),
        Selected = Color3.fromRGB(48, 44, 73),
        Border = Color3.fromRGB(61, 58, 88),
        Text = Color3.fromRGB(232, 231, 240),
        Sub = Color3.fromRGB(145, 142, 161),
        Muted = Color3.fromRGB(105, 102, 120),
        Accent = Color3.fromRGB(0, 220, 170),
        AccentDark = Color3.fromRGB(0, 155, 130)
    }

    local UIS = game:GetService("UserInputService")
    local TS = game:GetService("TweenService")
    local Players = game:GetService("Players")
    local Player = Players.LocalPlayer

    -- ===== HELPERS =====
    local function New(class, props, parent)
        local obj = Instance.new(class)
        for k, v in pairs(props or {}) do obj[k] = v end
        obj.Parent = parent
        return obj
    end

    local function Round(obj, r)
        New("UICorner", { CornerRadius = UDim.new(0, r or 8) }, obj)
    end

    local function Stroke(obj, color, thickness)
        New("UIStroke", {
            Color = color or C.Border,
            Thickness = thickness or 1,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        }, obj)
    end

    local function Tween(obj, props, duration)
        TS:Create(obj, TweenInfo.new(duration or .18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props):Play()
    end

