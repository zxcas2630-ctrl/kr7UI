 Kr7 UI Library (Roblox client-side)
--
-- Example:
-- local Kr7 = loadstring(game:HttpGet("YOUR_RAW_URL"))({ Title = "My UI" })
-- local Main = Kr7:CreateTab("Main")
-- Main:CreateButton({ Name = "Print", Callback = function() print("Hello") end })
--
-- The methods also accept the older positional style, for example:
-- Main:AddToggle("Enabled", "Turns it on", false, function(value) end)

return function(config)
    config = config or {}

    local Players = game:GetService("Players")
    local TweenService = game:GetService("TweenService")
    local UserInputService = game:GetService("UserInputService")
    local player = Players.LocalPlayer

    assert(player, "Kr7 must be run from a LocalScript/client executor")

    local theme = {
        Background = config.Background or Color3.fromRGB(19, 20, 30),
        Sidebar = config.Sidebar or Color3.fromRGB(24, 25, 38),
        Panel = config.Panel or Color3.fromRGB(31, 33, 48),
        PanelHover = config.PanelHover or Color3.fromRGB(41, 43, 62),
        Selected = config.Selected or Color3.fromRGB(46, 49, 71),
        Accent = config.Accent or Color3.fromRGB(108, 92, 231),
        AccentDark = config.AccentDark or Color3.fromRGB(76, 62, 181),
        Text = config.Text or Color3.fromRGB(241, 242, 248),
        SubText = config.SubText or Color3.fromRGB(161, 165, 188),
        Border = config.Border or Color3.fromRGB(57, 60, 83),
    }

    local function create(className, properties, parent)
        local instance = Instance.new(className)
        for property, value in pairs(properties or {}) do
            instance[property] = value
        end
        instance.Parent = parent
        return instance
    end

    local function corner(parent, radius)
        return create("UICorner", { CornerRadius = UDim.new(0, radius or 8) }, parent)
    end

    local function stroke(parent, color, thickness)
        return create("UIStroke", {
            Color = color or theme.Border,
            Thickness = thickness or 1,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        }, parent)
    end

    local function tween(instance, properties, duration)
        TweenService:Create(
            instance,
            TweenInfo.new(duration or 0.15, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
            properties
        ):Play()
    end

    local function runCallback(callback, ...)
        if type(callback) ~= "function" then
            return
        end

        local arguments = table.pack(...)
        task.spawn(function()
            local ok, err = pcall(function()
                callback(table.unpack(arguments, 1, arguments.n))
            end)
            if not ok then
                warn("[Kr7] control callback failed:", err)
            end
        end)
    end

    local function normalizeOptions(first, second, third, fourth, fifth, sixth)
        if type(first) == "table" then
            return first
        end
        return {
            Name = first,
            Description = second,
            Callback = third,
            Min = fourth,
            Max = fifth,
            CurrentValue = sixth,
        }
    end

    local oldGui = player:WaitForChild("PlayerGui"):FindFirstChild(config.GuiName or "Kr7UI")
    if oldGui then
        oldGui:Destroy()
    end
